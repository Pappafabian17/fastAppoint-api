  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "johndoe@example.com"
        },
        "role": {
          "type": "string",
          "example": "client"
        }
      }
    },
    "Service": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Premium Haircut"
        },
        "description": {
          "type": "string",
          "example": "Professional haircut, wash, and styling."
        },
        "durationMinutes": {
          "type": "number",
          "example": 45
        },
        "price": {
          "type": "number",
          "example": 35
        },
        "category": {
          "type": "string",
          "example": "Beauty"
        },
        "providerId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac2"
        }
      }
    },
    "Appointment": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac2"
        },
        "serviceId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac1"
        },
        "providerId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac0"
        },
        "appointmentDate": {
          "type": "string",
          "example": "2026-08-15T14:30:00Z"
        },
        "status": {
          "type": "string",
          "example": "pending"
        },
        "notes": {
          "type": "string",
          "example": "Please wash hair with cold water."
        }
      }
    },
    "Review": {
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac9"
        },
        "serviceId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac1"
        },
        "clientId": {
          "type": "string",
          "example": "6a7522059ed31a5944b78ac2"
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Excellent service! Highly recommended."
        }
      }
    }
  }
